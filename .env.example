# Which model provider to use. One of:
#   anthropic  openai  grok  ollama  huggingface  custom
PROVIDER=anthropic

DATABASE_URL=postgresql+psycopg:///renewal
TEST_DATABASE_URL=postgresql+psycopg:///renewal_test
BLOB_ROOT=blobs

# Model names as the selected provider spells them.
EXTRACTION_MODEL=claude-opus-5
DRAFT_MODEL=claude-sonnet-5

CONFIDENCE_THRESHOLD=0.80
MATERIALITY_CONFIG=config/materiality.yaml

# One key, for whichever provider is selected. Ollama needs none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
HF_TOKEN=
LLM_API_KEY=

# Only for PROVIDER=custom, or to point a preset somewhere else.
# vLLM, LM Studio, Text Generation Inference and llama.cpp all serve this.
LLM_BASE_URL=

# Running locally with Ollama:
#   ollama pull qwen2.5:7b
#   PROVIDER=ollama
#   EXTRACTION_MODEL=qwen2.5:7b
#   DRAFT_MODEL=qwen2.5:7b

# Seals blob bytes at rest with AES-GCM. Leave empty and blobs are stored
# unencrypted, which is the default for local development and the eval harness.
# Generate one with:
#   python -c "from renewal.crypto import generate_key; print(generate_key())"
# Losing this key means losing every document; back it up separately from the
# blob store, or the backup and the key travel together and the encryption
# buys nothing.
# BLOB_ENCRYPTION_KEY=

# Date extraction. The regex pass reads every page for free; this model only
# types those dates and finds the ones stated in prose ("within 30 days of the
# date of this notice"), which is why a smaller model than the extractor does.
DATE_MODEL=claude-sonnet-5

# DATE_PAGES bounds what that call costs. Deadlines live near the front of a
# document, and a cancellation notice is one or two pages, so the front of the
# document is the whole of it.
DATE_PAGES=3

# Classification is one label per document. The cheapest model does it.
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001

# Inbound mail. `filedrop` reads .eml files off the local disk and verifies
# NOTHING — it exists so the intake path can be exercised without a domain or
# an MX record. It must never be the configured provider on an install that is
# reachable from the network: anyone who can reach the webhook could then post
# mail into the record as any carrier.
# Adding authentication to the application does NOT close this: /inbound/mail
# is deliberately outside the login, because the caller is a mail provider
# that cannot sign in. Its only protection is the provider's own signature
# check, and filedrop performs none.
INBOUND_PROVIDER=filedrop
INBOUND_DROP_DIR=mail

# Authentication. Accounts are created from the command line only:
#   python -m scripts.add_user anne@agency.com
# There is no signup route and no password-reset email; re-running the script
# for an existing address resets that password.

# Set false ONLY for local development over plain HTTP. Left true, the session
# cookie is never sent over an unencrypted connection.
SESSION_COOKIE_SECURE=true

# About one working day, so she logs in each morning rather than mid-task.
# An active session slides, so a long review does not expire underneath her.
SESSION_TTL_HOURS=12
