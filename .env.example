# Which model provider to use. One of:
#   anthropic  openai  grok  ollama  huggingface  custom
PROVIDER=anthropic

DATABASE_URL=postgresql+psycopg:///renewal
TEST_DATABASE_URL=postgresql+psycopg:///renewal_test
BLOB_ROOT=blobs

# Model names as the selected provider spells them.
EXTRACTION_MODEL=claude-opus-5
DRAFT_MODEL=claude-sonnet-5

CONFIDENCE_THRESHOLD=0.80
MATERIALITY_CONFIG=config/materiality.yaml
EXTRAS_CONFIG=config/extras.yaml
# Percent move in total premium that raises a premium_change item.
ATTENTION_PREMIUM_PCT=10

# One key, for whichever provider is selected. Ollama needs none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
HF_TOKEN=
LLM_API_KEY=

# Only for PROVIDER=custom, or to point a preset somewhere else.
# vLLM, LM Studio, Text Generation Inference and llama.cpp all serve this.
LLM_BASE_URL=

# Running locally with Ollama:
#   ollama pull qwen2.5:7b
#   PROVIDER=ollama
#   EXTRACTION_MODEL=qwen2.5:7b
#   DRAFT_MODEL=qwen2.5:7b

# Seals blob bytes at rest with AES-GCM. Leave empty and blobs are stored
# unencrypted, which is the default for local development and the eval harness.
# Generate one with:
#   python -c "from renewal.crypto import generate_key; print(generate_key())"
# Losing this key means losing every document; back it up separately from the
# blob store, or the backup and the key travel together and the encryption
# buys nothing.
# BLOB_ENCRYPTION_KEY=

# Date extraction. The regex pass reads every page for free; this model only
# types those dates and finds the ones stated in prose ("within 30 days of the
# date of this notice"), which is why a smaller model than the extractor does.
DATE_MODEL=claude-sonnet-5

# DATE_PAGES bounds what that call costs. Deadlines live near the front of a
# document, and a cancellation notice is one or two pages, so the front of the
# document is the whole of it.
DATE_PAGES=3

# Classification is one label per document. The cheapest model does it.
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001

# Inbound mail. `filedrop` reads .eml files off the local disk and verifies
# NOTHING — it exists so the intake path can be exercised without a domain or
# an MX record. It must never be the configured provider on an install that is
# reachable from the network: anyone who can reach the webhook could then post
# mail into the record as any carrier.
# Adding authentication to the application does NOT close this: /inbound/mail
# is deliberately outside the login, because the caller is a mail provider
# that cannot sign in. Its only protection is the provider's own signature
# check, and filedrop performs none.
INBOUND_PROVIDER=filedrop
INBOUND_DROP_DIR=mail

# Authentication. Accounts are created from the command line only:
#   python -m scripts.add_user anne@agency.com
# There is no signup route and no password-reset email; re-running the script
# for an existing address resets that password.

# Set false ONLY for local development over plain HTTP. Left true, the session
# cookie is never sent over an unencrypted connection.
SESSION_COOKIE_SECURE=true

# About one working day, so she logs in each morning rather than mid-task.
# An active session slides, so a long review does not expire underneath her.
SESSION_TTL_HOURS=12

# Operator notifications: one email when documents are waiting, at most one an
# hour. Leave SMTP_HOST empty to turn them off — that is the default, because
# a misconfigured mail server must never be able to cost a document.
#
# This is the only mail the application sends, and it goes to the operator. No
# draft, comparison, or client communication is ever sent from here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_FROM=
NOTIFY_TO=
NOTIFY_MIN_INTERVAL_MINUTES=60

# Turn notifications off without clearing the recipient. Also editable from
# /settings, and the stored value there wins over this one.
NOTIFY_ENABLED=true

# Used to build the link in that email.
BASE_URL=http://127.0.0.1:8000

# The daily summary's clock. AGENCY_TZ is the timezone whose eight o'clock is
# meant by "Send that summary after" on /settings — everything else in this
# application is UTC, so leaving this unset sends the summary at four in the
# morning on the east coast. DIGEST_TICK_SECONDS is how often the application
# asks whether the summary is due; 0 turns the in-process clock off entirely,
# for an install driving `python -m scripts.digest` from cron instead.
AGENCY_TZ=UTC
DIGEST_TICK_SECONDS=300

# ---------------------------------------------------------------------------
# Deployment tuning.
#
# Everything below is set once against the machine this runs on. None of it is
# a judgment about insurance, which is why none of it is on a screen. The
# settings that ARE judgments — how eager the alerts are, who gets told, how
# long a session lasts — she edits at /settings, and the value stored there
# wins over anything set here.
# ---------------------------------------------------------------------------

# How long a document may sit in 'processing' before the inbox calls it
# stalled and offers a Retry. In-process background work dies with the
# process, so this is how a restart mid-intake becomes visible rather than a
# row that says "working on it" forever.
STALLED_AFTER_MINUTES=10

# How often the inbox reloads itself while anything is still being read. It
# stops polling the moment nothing is.
INBOX_POLL_SECONDS=4

# Rows on the inbox. Past a couple of hundred the inbox is not the right
# screen any more and search is; the cap keeps a bulk-imported archive from
# turning the front door into a several-second query.
INBOX_LIMIT=200

# Concurrent intake workers. Intake is mostly waiting on a model provider, so
# a third buys little for one person dropping in a file.
INTAKE_WORKERS=2

# How similar a client name has to look before it is offered as a candidate on
# an unmatched document. Lower surfaces more near-misses to choose between.
#
# This is NOT the auto-link threshold. A document files itself only on an
# exact policy-number match (D8), and that is deliberately not configurable
# anywhere: a fuzzy match that files itself would attach one client's renewal
# to another client's policy and report success.
NAME_SIMILARITY_FLOOR=0.3

# Starting value for the attention queue's date horizon. She can change it at
# /settings, and that wins.
UNCONFIRMED_DATE_WINDOW_DAYS=14
